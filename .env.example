# Choose a private value before starting the server. Never commit a filled .env.
SHELF_ACCESS_CODE=
# Alternatively set SHELF_ACCESS_HASH_FILE to a runtime SHA-256 verifier file.
SHELF_DB_PATH=data/library.sqlite
HOST=127.0.0.1
PORT=4174
# Enable signed snapshot imports by providing an Ed25519 PUBLIC key file.
# SHELF_PUBLISHER_PUBLIC_KEY_FILE=local/publisher.pub

# Set to 1 only when serving an isolated synthetic demonstration catalog.
SHELF_DEMO_MODE=0
