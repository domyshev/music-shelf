# Development origin; change to the exact HTTPS site origin in production.
SHELF_ORIGIN=http://127.0.0.1:5173
# Supply privately; never commit a populated .env file.
RESEND_API_KEY=
EMAIL_FROM=
# Optional existing file containing 64 random hexadecimal characters.
# Without this variable, a private auth.secret is created beside the database.
# SHELF_AUTH_SECRET_FILE=local/auth.secret
SHELF_DB_PATH=data/library.sqlite
HOST=127.0.0.1
PORT=4174
# Public Ed25519 key for signed metadata imports; never a private key.
# SHELF_PUBLISHER_PUBLIC_KEY_FILE=local/publisher.pub
SHELF_DEMO_MODE=0
